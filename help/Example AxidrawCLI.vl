          <Pad Id="VUHkTsNNmUsL8Gt44hyC0g" Bounds="-9,-88,620,89" ShowValueBox="true" isIOBox="true" Value="AxiDrawCLI Interface">
            <p:TypeAnnotation LastCategoryFullName="Primitive" LastDependency="VL.CoreLib.vl">

          <Pad Id="FtSjjGvZHjGM4SKaA6lAvf" SlotId="HecnShZSOA0O7BMuqy46bk" Bounds="321,1083" />
          <Pad Id="BEGSVW144eNNg3cAJy6GVn" Bounds="688,22,306,368" ShowValueBox="true" isIOBox="true" Value="CALL ME BOT&#xD;&#xA;&#xD;&#xA;If you’d like to receive a WhatsApp message once the plot is complete, you can subscribe to the free Call Me Bot service.&#xD;&#xA;&#xD;&#xA;RUNTIME CONFIGURATION&#xD;&#xA;&#xD;&#xA;After completing the setup steps above, fill in the required values in the I/O boxes to configure the runtime settings. These values will override any corresponding settings in the configuration file.">
            <p:TypeAnnotation LastCategoryFullName="Primitive" LastDependency="VL.CoreLib.vl">
              <Choice Kind="TypeFlag" Name="String" />
            </p:TypeAnnotation>
            <p:ValueBoxSettings>
              <p:fontsize p:Type="Int32">9</p:fontsize>
